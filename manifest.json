{
  "manifest_version": 3,
  "version": "2.4.1.1",
  "default_locale": "en",
  "name": "Barebones Better Lyrics",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/Hantu-Raya/barebones-better-lyrics",
  "icons": {
    "16": "images/icons/icon-16.png",
    "48": "images/icons/icon-48.png",
    "512": "images/icons/icon-512.png"
  },
  "chromium:key": "",
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' data: https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self';"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "resources": [
        "_locales/*/messages.json",
        "css/blyrics/*.css",
        "css/ytmusic/*.css"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/index.ts"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "public/earlyInject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "public/script.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "version_name": "2.4.1+nativune.1"
}
